{
  "name": "captain-mostafa-el-reedy-gym",
  "version": "1.1.0",
  "description": "Arabic RTL desktop gym management system for Captain Mostafa El Reedy",
  "main": "src/main.js",
  "author": "Captain Mostafa El Reedy Gym",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "realm": "20.2.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "eg.captainmostafa.gym",
    "productName": "Captain Mostafa Gym",
    "asar": true,
    "asarUnpack": ["**/node_modules/realm/**"],
    "files": ["src/**/*", "package.json", "README.md"],
    "directories": {"output": "dist"},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}]},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Captain Mostafa Gym"
    }
  }
}
