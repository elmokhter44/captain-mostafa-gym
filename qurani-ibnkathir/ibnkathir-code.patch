@@ -0,0 +1,137 @@
+package com.qurani.ibnkathir.pdf
+
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.graphics.pdf.PdfRenderer
+import android.net.Uri
+import android.os.ParcelFileDescriptor
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.util.concurrent.Executors
+import kotlin.math.roundToInt
+
+class PdfAssetModule(private val context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  private val executor = Executors.newSingleThreadExecutor()
+  private val validAsset = Regex("^[a-z0-9_]+\\.pdf$")
+
+  override fun getName(): String = "PdfAsset"
+
+  private fun validateAsset(assetName: String) {
+    require(validAsset.matches(assetName)) { "Invalid asset name" }
+  }
+
+  @Synchronized
+  private fun ensureAsset(assetName: String): File {
+    validateAsset(assetName)
+    val dir = File(context.filesDir, "pdf")
+    if (!dir.exists() && !dir.mkdirs()) throw IOException("Could not create PDF directory")
+    val target = File(dir, assetName)
+    if (target.exists() && target.length() > 0) return target
+
+    val temp = File(dir, "$assetName.tmp")
+    context.assets.open("pdf/$assetName").use { input ->
+      FileOutputStream(temp).use { output -> input.copyTo(output, 128 * 1024) }
+    }
+    if (!temp.renameTo(target)) {
+      temp.copyTo(target, overwrite = true)
+      temp.delete()
+    }
+    return target
+  }
+
+  private inline fun <T> withRenderer(file: File, block: (PdfRenderer) -> T): T {
+    val descriptor = ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)
+    val renderer = PdfRenderer(descriptor)
+    return try { block(renderer) } finally {
+      renderer.close()
+      descriptor.close()
+    }
+  }
+
+  @ReactMethod
+  fun prepareAsset(assetName: String, promise: Promise) {
+    executor.execute {
+      try {
+        val file = ensureAsset(assetName)
+        promise.resolve(file.absolutePath)
+      } catch (e: IllegalArgumentException) {
+        promise.reject("E_PDF_ASSET_INVALID", e.message, e)
+      } catch (e: Exception) {
+        promise.reject("E_PDF_ASSET_COPY", "تعذر تجهيز ملف المصحف", e)
+      }
+    }
+  }
+
+  @ReactMethod
+  fun getPageCount(assetName: String, promise: Promise) {
+    executor.execute {
+      try {
+        val file = ensureAsset(assetName)
+        val count = withRenderer(file) { it.pageCount }
+        promise.resolve(count)
+      } catch (e: IllegalArgumentException) {
+        promise.reject("E_PDF_ASSET_INVALID", e.message, e)
+      } catch (e: Exception) {
+        promise.reject("E_PDF_OPEN", "تعذر فتح ملف المصحف", e)
+      }
+    }
+  }
+
+  @ReactMethod
+  fun renderPage(assetName: String, pageIndex: Int, widthPx: Int, promise: Promise) {
+    executor.execute {
+      try {
+        validateAsset(assetName)
+        require(pageIndex >= 0) { "Invalid page index" }
+        require(widthPx in 240..2400) { "Invalid render width" }
+
+        val safeStem = assetName.removeSuffix(".pdf")
+        val cacheDir = File(context.cacheDir, "qurani-pages/$safeStem")
+        if (!cacheDir.exists() && !cacheDir.mkdirs()) throw IOException("Could not create page cache")
+        val output = File(cacheDir, "$pageIndex-$widthPx.png")
+        if (output.exists() && output.length() > 0) {
+          promise.resolve(Uri.fromFile(output).toString())
+          return@execute
+        }
+
+        val file = ensureAsset(assetName)
+        withRenderer(file) { renderer ->
+          require(pageIndex < renderer.pageCount) { "Page index out of range" }
+          val page = renderer.openPage(pageIndex)
+          try {
+            val scale = widthPx.toFloat() / page.width.toFloat()
+            val heightPx = (page.height * scale).roundToInt().coerceAtLeast(1)
+            val bitmap = Bitmap.createBitmap(widthPx, heightPx, Bitmap.Config.ARGB_8888)
+            bitmap.eraseColor(Color.WHITE)
+            page.render(bitmap, null, null, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
+            val temp = File(cacheDir, "$pageIndex-$widthPx.tmp")
+            FileOutputStream(temp).use { stream ->
+              if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream)) {
+                throw IOException("PNG compression failed")
+              }
+            }
+            bitmap.recycle()
+            if (!temp.renameTo(output)) {
+              temp.copyTo(output, overwrite = true)
+              temp.delete()
+            }
+          } finally {
+            page.close()
+          }
+        }
+        promise.resolve(Uri.fromFile(output).toString())
+      } catch (e: IllegalArgumentException) {
+        promise.reject("E_PDF_PAGE_INVALID", e.message, e)
+      } catch (e: SecurityException) {
+        promise.reject("E_PDF_SECURITY", "تعذر الوصول إلى ملف المصحف", e)
+      } catch (e: Exception) {
+        promise.reject("E_PDF_RENDER", "تعذر عرض الصفحة. حاول مرة أخرى.", e)
+      }
+    }
+  }
+}
