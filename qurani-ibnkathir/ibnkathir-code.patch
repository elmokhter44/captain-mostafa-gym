+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {SECTIONS} from '../src/data/sections.ts';
+import {INDEX_HOTSPOTS} from '../src/data/indexHotspots.ts';
+import {mushafToSourcePage, sourceToMushafPage} from '../src/utils/pageMapping.ts';
+
+const expected = [
+  ['quran', 'المصحف', '', 5, 608, 'quran.pdf', true],
+  ['index', 'الفهرس', '', 609, 610, 'quran_index.pdf', undefined],
+  ['dua', 'الدعاء', '', 611, 611, 'dua.pdf', undefined],
+  ['waqf-symbols', 'علامات الوقف ومصطلحات الضبط ودلالات الرمز والترميز اللوني للقراءات العشر في مصاحف السلسلة الفراتية', '', 612, 616, 'waqf_symbols.pdf', undefined],
+  ['furati-intro', 'من بين يدي السلسلة الفراتية', '', 617, 620, 'furati_intro.pdf', undefined],
+  ['ibn-kathir-usul', 'شرح اصول قراءة الامام بن كثير المكي', '', 621, 632, 'ibn_kathir_usul.pdf', undefined],
+] as const;
+
+test('Ibn Kathir app exposes exactly the six approved cards and source ranges with no subtitles', () => {
+  assert.deepEqual(SECTIONS.map(s => [s.id, s.title, s.subtitle, s.sourceStartPage, s.sourceEndPage, s.assetName, s.featured]), expected);
+});
+
+test('604 mushaf pages map exactly to source PDF pages 5 through 608', () => {
+  assert.equal(mushafToSourcePage(1), 5);
+  assert.equal(mushafToSourcePage(604), 608);
+  assert.equal(sourceToMushafPage(5), 1);
+  assert.equal(sourceToMushafPage(608), 604);
+  assert.throws(() => sourceToMushafPage(609));
+});
+
+test('index has one bounded hotspot per surah on source pages 609 and 610', () => {
+  assert.equal(INDEX_HOTSPOTS.length, 114);
+  assert.equal(new Set(INDEX_HOTSPOTS.map(h => h.surahId)).size, 114);
+  assert.deepEqual([...new Set(INDEX_HOTSPOTS.map(h => h.indexPdfPage))].sort(), [609, 610]);
+  for (const h of INDEX_HOTSPOTS) {
+    assert.ok(h.x >= 0 && h.y >= 0 && h.width > 0 && h.height > 0);
+    assert.ok(h.x + h.width <= 1.001);
+    assert.ok(h.y + h.height <= 1.001);
+  }
+});
+
+test('home and index preserve the master UI behavior while using Ibn Kathir labels and no card descriptions', () => {
+  const home = readFileSync('src/features/home/HomeScreen.tsx', 'utf8');
+  const card = readFileSync('src/features/home/SectionCard.tsx', 'utf8');
+  const index = readFileSync('src/features/index/IndexScreen.tsx', 'utf8');
+  assert.match(home, /المصحف المعلّم بقراءة الإمام ابن كثير المكي/);
+  assert.doesNotMatch(home, /featuredSubtitle/);
+  assert.doesNotMatch(home, /featuredEyebrow/);
+  assert.doesNotMatch(home, /featuredPill/);
+  assert.match(card, /section\.subtitle \?/);
+  assert.match(index, /ZoomablePdfPage/);
+  assert.match(index, /pageWidthForScreen/);
+  assert.match(index, /scrollEnabled=\{!pageZoomed\}/);
+  assert.match(index, /ScreenHeader title="الفهرس"/);
+});
