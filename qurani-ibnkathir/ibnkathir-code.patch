+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {PACKAGE_NAME, VERSION_CODE, VERSION_NAME} from '../src/app/constants.ts';
+
+test('Ibn Kathir app has an independent Android identity and release version', () => {
+  assert.equal(PACKAGE_NAME, 'com.qurani.ibnkathir');
+  assert.equal(VERSION_NAME, '1.0.0');
+  assert.equal(VERSION_CODE, 1);
+  const gradle = readFileSync('android/app/build.gradle', 'utf8');
+  assert.match(gradle, /namespace "com\.qurani\.ibnkathir"/);
+  assert.match(gradle, /applicationId "com\.qurani\.ibnkathir"/);
+  assert.match(gradle, /versionCode 1/);
+  assert.match(gradle, /versionName "1\.0\.0"/);
+});
+
+test('Android launcher label and React display name use the approved Ibn Kathir title', () => {
+  const strings = readFileSync('android/app/src/main/res/values/strings.xml', 'utf8');
+  const appJson = readFileSync('app.json', 'utf8');
+  assert.match(strings, /المصحف المعلم\\nبقراءة الإمام ابن كثير المكي/);
+  assert.match(appJson, /المصحف المعلم بقراءة الإمام ابن كثير المكي/);
+});
